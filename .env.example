# API del backend NestJS
NEXT_API_URL=http://localhost:3001
# En Vercel (Production): NEXT_API_URL=https://saasafrback.vercel.app
# Usa la URL sin barra final. Cambiar esta variable requiere un nuevo build.

# Canales alternativos de la pantalla de Soporte. Son datos de la plataforma, no
# del tenant, por eso viven aqui y no en la base de datos. Si se dejan vacios,
# los botones de WhatsApp y de correo no se pintan.
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_EMAIL=
